# Port the server listens on. Hostinger / most hosts inject PORT automatically.
PORT=3000

# Password for the /admin panel (HTTP Basic Auth, any username).
# Leave it UNSET to keep /admin disabled: every admin route then answers 503.
# ADMIN_PASSWORD=change-me

# --- Are We A Match? — durées de partie (ms) et longueur d'une manche --------
# Valeurs par défaut ci-dessous ; utiles surtout pour les tests automatisés.
# MATCH_QUESTIONS=10
# MATCH_QUESTION_MS=30000
# MATCH_REVEAL_MS=5000
# MATCH_RESULTS_MS=60000
