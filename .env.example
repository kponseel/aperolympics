# Port the server listens on. Hostinger / most hosts inject PORT automatically.
PORT=3000

# Dossier où sont stockés les comptes (pseudo, PIN, stats, réponses).
# DOIT être HORS du dossier de l'application : un déploiement qui remplace le
# dossier de l'app emporte tout ce qui s'y trouve, et les fichiers de comptes
# sont gitignorés — ils ne reviennent donc pas du dépôt.
# Non défini, le serveur retombe sur ~/.aperolympics (hors app, donc conservé).
# DATA_DIR=/home/<user>/aperolympics-data

# Password for the /admin panel (HTTP Basic Auth, any username).
# Leave it UNSET to keep /admin disabled: every admin route then answers 503.
# ADMIN_PASSWORD=change-me

# --- Are We A Match? — durées de partie (ms) et longueur d'une manche --------
# Valeurs par défaut ci-dessous ; utiles surtout pour les tests automatisés.
# MATCH_QUESTIONS=10
# MATCH_QUESTION_MS=30000
# MATCH_REVEAL_MS=5000
# MATCH_RESULTS_MS=60000
